
# Used to sign login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY= secret_key_here

# Postgres settings used by docker-compose
POSTGRES_USER=username_here
POSTGRES_PASSWORD=password_here
POSTGRES_DB=database_name_here

# Only for running the app outside Docker (leave unset to use SQLite)
# DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/database_name