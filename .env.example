# Used to sign login tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=secret_key_here

# Postgres settings used by docker-compose
POSTGRES_USER=username_here
POSTGRES_PASSWORD=password_here
POSTGRES_DB=database_name_here

# Only for running the app outside Docker (leave unset to use SQLite)
# DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/database_name

# Domain Caddy gets an HTTPS certificate for (only needed with the https profile)
DOMAIN=your-domain-here

# Log level for the JSON logs: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
# ---------- Logs, timeouts and limits (all optional; defaults shown) ----------

# Docker Compose writes the JSON logs to ./logs/app.log as well as to
# `docker compose logs`. Each file grows to this size, then rotates:
# LOG_FILE_MAX_MB=10
# LOG_FILE_BACKUPS=5
# To also write a log file when running without Docker:
# LOG_FILE=logs/app.log

# Seconds to wait when connecting to Postgres, and for a free pooled connection
# DB_CONNECT_TIMEOUT=3
# DB_POOL_TIMEOUT=5

# Container limits. Raise them on a bigger server.
# API_MEMORY_LIMIT=256m
# API_CPU_LIMIT=0.50
# DB_MEMORY_LIMIT=256m
# DB_CPU_LIMIT=0.50

# Which optional services to start, comma-separated:
#   https      Caddy with HTTPS (needs DOMAIN)
#   telemetry  Prometheus, keeping metrics history on 127.0.0.1:9090
# COMPOSE_PROFILES=https,telemetry
# How long Prometheus keeps metrics
# PROMETHEUS_RETENTION=7d
